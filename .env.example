PIXELPROOF_ENV=production
PIXELPROOF_HOST=0.0.0.0
PIXELPROOF_PORT=8000
PIXELPROOF_DATABASE_PATH=/data/pixelproof.db
PIXELPROOF_REPORT_SIGNING_SECRET=replace-with-a-long-random-secret
# Optional: point image and video analysis at separate promoted model folders.
# Leave blank to use the repo defaults under code/backend/model/profiles/.
# PIXELPROOF_IMAGE_MODEL_DIR=/app/code/backend/model/profiles/image_best
# PIXELPROOF_VIDEO_MODEL_DIR=/app/code/backend/model/profiles/video_best
PIXELPROOF_CORS_ORIGINS=https://your-domain.example
PIXELPROOF_TRUSTED_HOSTS=your-domain.example,www.your-domain.example
PIXELPROOF_CORS_ALLOW_CREDENTIALS=false
PIXELPROOF_HISTORY_LIMIT=100
PIXELPROOF_MAX_UPLOAD_MB=50
PIXELPROOF_MAX_VIDEO_DURATION_SECONDS=20
PIXELPROOF_WARMUP_ON_STARTUP=true
PIXELPROOF_ANALYZE_RATE_LIMIT_COUNT=20
PIXELPROOF_ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60
PIXELPROOF_ENABLE_GZIP=true
PIXELPROOF_ENABLE_CSP=true
PIXELPROOF_CSP_CONNECT_SRC='self'
PIXELPROOF_ENABLE_HSTS=true
VITE_API_BASE_URL=
